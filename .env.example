# Copy to .env and adjust. .env is gitignored. Never put real credentials in this file.
# docker compose reads it automatically.

# --- Local filesystem (the default) ---
LAKEHOUSE_STORAGE_ROOT=file:///opt/project/data/lakehouse
# LAKEHOUSE_LANDING_ROOT is unset: bronze reads straight from the local landing dir.

# --- S3 (after `terraform apply`; take the values from `terraform output`) ---
# LAKEHOUSE_STORAGE_ROOT=s3a://commerce-lakehouse-<account-id>/lakehouse
# LAKEHOUSE_LANDING_ROOT=s3a://commerce-lakehouse-<account-id>/landing
# AWS credentials come from a named profile in ~/.aws/credentials (mounted read-only into the container).
# AWS_PROFILE=commerce-lakehouse
# AWS_REGION=us-east-1

LAKEHOUSE_LOG_LEVEL=INFO

# Spark local mode tuning (the default of 200 shuffle partitions is far too many on a laptop).
SPARK_SHUFFLE_PARTITIONS=8
SPARK_DRIVER_MEMORY=2g

# --- Optional Slack alerting on task failure ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
