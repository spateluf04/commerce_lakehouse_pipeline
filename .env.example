# Copy to .env and adjust. .env is gitignored. Never put real credentials in this file.

# Where Delta tables live. Local:  file:///opt/project/data/lakehouse
#                          S3:     s3a://<your-bucket>/lakehouse   (stage 4)
LAKEHOUSE_STORAGE_ROOT=file:///opt/project/data/lakehouse

# Local directory the generator writes raw daily files to.
LAKEHOUSE_LANDING_DIR=/opt/project/data/landing

LAKEHOUSE_LOG_LEVEL=INFO

# Spark local mode tuning (the default of 200 shuffle partitions is far too many on a laptop).
SPARK_SHUFFLE_PARTITIONS=8
SPARK_DRIVER_MEMORY=2g

# --- Stage 4: AWS. Use a named profile from ~/.aws/credentials, not raw keys. ---
# AWS_PROFILE=commerce-lakehouse
# AWS_REGION=us-east-1

# --- Stage 5: optional Slack alerting. ---
# SLACK_WEBHOOK_URL=
